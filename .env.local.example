# ============================================
# EMET Platform - Environment Variables
# ============================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI Providers (Priority: Groq → Google → OpenAI → Anthropic) ---
GROQ_API_KEY=your-groq-api-key
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- EMET Intelligence Backbone ---
# Protect server-to-server intelligence APIs with independent long random secrets.
EMET_INGEST_SECRET=replace-with-long-random-ingest-secret
EMET_SIGNALS_SECRET=replace-with-long-random-signals-secret

# U.S. Census Bureau Data API
CENSUS_API_KEY=your-census-api-key
CENSUS_ACS_YEAR=2024
CENSUS_ACS_DATASET=acs/acs5
# Florida defaults; override per deployment/ingestion strategy.
CENSUS_STATE_FIPS=12
CENSUS_COUNTY_FIPS=*
# If customized, keep the B01001 total + age-65-plus variables required by the processor.
# CENSUS_ACS_FIELDS=NAME,B01001_001E,...

# CMS Provider Data Catalog. Pin the stable official DATASET ID selected for production.
CMS_PROVIDER_DATASET_ID=your-cms-dataset-id
CMS_PROVIDER_PAGE_SIZE=250
CMS_PROVIDER_OFFSET=0

# --- Solana ---
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=your-jwt-secret-min-32-chars

# --- Social APIs (Phase 2) ---
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# INSTAGRAM_ACCESS_TOKEN=
